{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "data/schemas/**"
    }
  },
  "redirects": [
    {
      "source": "/data/:pad*",
      "destination": "/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/voorwaarden",
      "destination": "/voorwaarden.html"
    },
    {
      "source": "/mijn-programma",
      "destination": "/mijn-programma.html"
    },
    {
      "source": "/coach-afval",
      "destination": "/coach-afval.html"
    },
    {
      "source": "/mijn-core",
      "destination": "/mijn-core.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/banden",
      "destination": "/app.html"
    },
    {
      "source": "/rit/:id",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/afvalprogramma?actie=herinner",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/core?actie=herinner",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/app?actie=pushcron",
      "schedule": "*/15 4-11 * * *"
    },
    {
      "path": "/api/lid?actie=herinner",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/app?actie=opruimen",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/lid?actie=weekoverzicht",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/lid?actie=backup",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/lid?actie=cadeaumail",
      "schedule": "5 10 16 10 *"
    },
    {
      "path": "/api/lid?actie=cadeaumail",
      "schedule": "5 8 17-21 10 *"
    }
  ]
}
