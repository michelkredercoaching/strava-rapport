{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/voorwaarden",
      "destination": "/voorwaarden.html"
    },
    {
      "source": "/mijn-programma",
      "destination": "/mijn-programma.html"
    },
    {
      "source": "/coach-afval",
      "destination": "/coach-afval.html"
    },
    {
      "source": "/mijn-core",
      "destination": "/mijn-core.html"
    }
  ],
  "crons": [
    {
      "path": "/api/afvalprogramma?actie=herinner",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/core?actie=herinner",
      "schedule": "0 6 * * 1"
    }
  ]
}
